{
  "name": "opencode-claude-plugins",
  "version": "0.1.0",
  "description": "OpenCode plugin that loads and runs Claude Code plugins as native OpenCode skills, commands, agents, MCP servers, instructions, and hooks.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-claude-plugins": "./dist/cli.js"
  },
  "files": [
    "dist",
    "index.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harnesstap/opencode-agent-plugin-support.git"
  },
  "homepage": "https://github.com/harnesstap/opencode-agent-plugin-support#readme",
  "bugs": {
    "url": "https://github.com/harnesstap/opencode-agent-plugin-support/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "claude-code",
    "claude-plugins",
    "skills",
    "mcp"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=0.15.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
